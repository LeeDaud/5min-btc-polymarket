# Polymarket API Credentials
# Copy this file to .env and fill in your values.
# WARNING: .env contains your wallet private key. NEVER commit it.

# Polygon wallet private key (hex string, no 0x prefix)
PM_PRIVATE_KEY=

# Polymarket L2 API credentials (get from https://polymarket.com/settings/api-keys)
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# Optional: funder wallet address (auto-derived if blank)
PM_FUNDER=

# Signature type: 0=EOA, 1=MagicLink, 2=Proxy (default: 2)
PM_SIGNATURE_TYPE=2
